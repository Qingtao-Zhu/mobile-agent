<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形玻璃按钮（麦克风）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/assistant_glass_fill_strong" />
            <stroke
                android:width="1dp"
                android:color="@color/assistant_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/assistant_glass_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/assistant_glass_stroke" />
        </shape>
    </item>
</selector>
