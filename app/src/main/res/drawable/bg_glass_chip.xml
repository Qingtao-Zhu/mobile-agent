<?xml version="1.0" encoding="utf-8"?>
<!-- 建议 chip / 操作按钮：小胶囊玻璃，按下亮一档。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/assistant_glass_fill_strong" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/assistant_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/assistant_glass_fill" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/assistant_glass_stroke" />
        </shape>
    </item>
</selector>
