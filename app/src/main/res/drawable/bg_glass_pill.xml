<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：全圆角胶囊玻璃，聚焦时描边变亮并亮一档底。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/assistant_glass_fill_strong" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/assistant_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/assistant_glass_fill" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="@color/assistant_glass_stroke" />
        </shape>
    </item>
</selector>
